# Configuration for a Linux server. Copied to `.env` on the machine.
#
# THIS FILE HOLDS NO SECRETS AND IS COMMITTED. The password below is empty
# on purpose; fill it in on the server, in the copy, never here.
#
# It sets EVERY variable the app reads, and that is the point rather than
# thoroughness for its own sake. `app/settings.py` loads `.env` and then
# `.env.example`, so anything left unset here falls back to the committed
# template — which carries Windows paths. That is not a quiet failure: on
# Linux `os.pathsep` is ':', so `C:\VideoScoreSync\scores` arrives as two
# score roots, one called `C` and one called `\VideoScoreSync\scores`. It
# happened on the first deployment. Leaving no gaps is what prevents it.

# --- Where the pieces live -------------------------------------------------
# Score packages, produced by music_line_extractor and copied here. They are
# build products and live in no repository.
SCORE_ROOT_DIGITAL=/srv/vsw/scores
SCORE_ROOT_RASTER=
COMPOSER_FILTER=Chopin

# Videos already on the machine, offered instead of an upload. Not used in
# production; every video arrives from a visitor.
VIDEO_ROOT=

# --- music_line_extractor: not needed ---------------------------------------
# Nothing on the running path imports it. Alignment goes through
# VideoScoreSync's services; the only reference left is app/autosync.py,
# which nothing but a developer script uses.

# --- Title panel and backdrops ---------------------------------------------
# Licensed, so they are in no repository and no release. They live in
# shared/ beside .env — supplied once per host, surviving deploys.
# Wrong or missing, every render WITH A TITLE PANEL fails and one
# without succeeds, which is why this went unnoticed: the default is
# no panel, so nothing touched the fonts until Centered worked.
FONT_DIR=/srv/vsw/shared/fonts
BACKGROUND_STATIC=
BACKGROUND_DYNAMIC=

# --- Tools ------------------------------------------------------------------
FFMPEG_EXE=ffmpeg
FFPROBE_EXE=ffprobe

# --- Where the work happens -------------------------------------------------
WORK_DIR=/srv/vsw/work

# --- Recognition ------------------------------------------------------------
# ID_PYTHON is the SAME interpreter as everything else here, which is the
# whole difference from Windows: torch, numba and cairo coexist on Linux, so
# there is no second environment to reach into.
ID_ROOT=/srv/vsw/music_fingerprints
ID_PYTHON=/srv/vsw/venv/bin/python
ID_INDEX_DIR=/srv/vsw/data
PAIR_LIST=/srv/vsw/data/pair_list.json
IDENTIFY_MIN_SECONDS=20
IDENTIFY_TIMEOUT=600
# The provider. LINODE_TOKEN is the only credential in this system that can
# spend money without limit — it belongs on the web box and must never reach
# a compute node or an image. It is the token of a RESTRICTED user that can
# create Linodes and see nothing else.
LINODE_TOKEN=
COMPUTE_REGION=eu-central
# The captured image the compute node boots from, e.g. private/41111680
COMPUTE_IMAGE=
COMPUTE_PLAN=g6-dedicated-4
# A ceiling. A loop that creates machines is not a bug that costs an
# afternoon; refused beyond this many an hour, whatever the queue says.
# OFF until deliberately turned on. Everything up to creating a machine runs
# and is recorded regardless — the dashboard shows what WOULD have happened
# — and this is the first thing here that can spend money unattended.
COMPUTE_ENABLED=false
# Where a compute node reaches the broker: the web box's VLAN address, never
# its public one.
COMPUTE_BROKER_HOST=10.0.0.2
COMPUTE_MAX_CREATES_PER_HOUR=4
# Put on each machine at create, so somebody can get in and look.
COMPUTE_SSH_KEY=


# See .env.example.
COMPUTE_GRACE_SECONDS=600
COMPUTE_HOURLY_COST=0.108

# See .env.example. OBJECT_SECRET is a credential and belongs only here.
OBJECT_ENDPOINT=
OBJECT_REGION=
OBJECT_BUCKET=
OBJECT_KEY=
OBJECT_SECRET=
# A SCOPED object-storage key for compute nodes. The key above can read and
# delete every video and every DB backup; a compute node — the box running
# strangers' media through ffmpeg — must not hold that. Create a Limited
# Access Key in Linode Object Storage with read/write on THIS bucket only
# and no access to backups, put it here, and cloud-init sends it to the node
# in place of the full key. Leave empty and the full key is sent with a
# marker saying so; do not turn COMPUTE_ENABLED on until these are set.
OBJECT_KEY_COMPUTE=
OBJECT_SECRET_COMPUTE=

# See .env.example. deploy/fetch-geoip.sh writes this file and refreshes the
# symlink; run it monthly, because addresses are reassigned.
GEOIP_DB=/srv/vsw/shared/geoip/current.mmdb

# --- Alignment --------------------------------------------------------------
# Also the same interpreter. On Windows chroma extraction ABORTS the process
# under the app's environment — an uncatchable LLVM error about a missing
# Intel vector symbol — which is why it runs elsewhere there and not here.
VSS_ROOT=/srv/vsw/VideoScoreSync
SYNC_PYTHON=/srv/vsw/venv/bin/python
SYNC_TIMEOUT=900

# --- Telling people their video is ready ------------------------------------
# SMTP_PASSWORD stays EMPTY in this file. Set it in the copy on the server.
SMTP_HOST=nl1-ss24.a2hosting.com
SMTP_PORT=465
SMTP_USER=info@weefeen.com
SMTP_PASSWORD=
SMTP_FROM=Weefeen <info@weefeen.com>

# See .env.example. Alerts go here; deploy/install-alert-mail.sh copies this
# and the SMTP_* values above into grafana.ini.
ALERT_EMAIL=
SMTP_SSL=true
SMTP_STARTTLS=false

# Where a link in that mail points. The app REFUSES to send while this names
# this machine: a link to 127.0.0.1 is useless to whoever receives it, and
# an unreachable private address reads as spam, which spends the domain's
# standing on a message nobody could have used.
PUBLIC_BASE_URL=https://chopin.weefeen.com

# --- The bot check ----------------------------------------------------------
# Cloudflare Turnstile. Free, needs only a Cloudflare login, and does NOT
# require this domain to be on Cloudflare. BOTH must be set for the check to
# run; either empty and every upload is waved through exactly as before.
# The SECRET is a credential — set it in the copy on the server, never here.
# Get both at dash.cloudflare.com -> Turnstile -> add a site for
# chopin.weefeen.com. The site key is public; the secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- How much one visitor may use -------------------------------------------
LIMIT_UPLOADS_PER_HOUR=8
LIMIT_IDENTIFY_PER_HOUR=8
LIMIT_RENDERS_PER_WEEK=3
LIMIT_RENDERS_PER_EMAIL_WEEK=3
LIMIT_MAIL_PER_EMAIL_WEEK=4

# See .env.example.
LIMIT_QUEUED_MAIL_PER_EMAIL_WEEK=4
# See .env.example.
LIMIT_COMPUTE_MAIL_PER_DAY=40

LIMIT_MAIL_PER_DAY=200

# MUST be true behind Apache. Left off, every visitor arrives as 127.0.0.1
# and they all share one rate-limit bucket — so the eighth upload of the
# hour locks out everybody. Apache must be set to OVERWRITE X-Forwarded-For
# (mod_remoteip), not append to a client-supplied one, or the header can be
# forged for unlimited quota.
TRUST_PROXY=true

# --- How long a finished video stays downloadable ---------------------------
RETENTION_HOT_HOURS=48
ARCHIVE_TRANSITION_DAYS=3

# --- Size and length --------------------------------------------------------
# 500 MB rejected most phone recordings; the render is a fixed 1080p canvas
# either way. Length is what costs: the encode grows with it and the
# aligner's memory with the SQUARE of it — a full N×M DTW matrix. Measured
# on this box: 7.1 min → 2.43 GB, 14.1 min → 4.62 GB against 3.9 GB of RAM,
# so past ~11 minutes a single upload OOM-kills the box. 8 is what it
# survives (~2.7 GB peak). Raising it needs a bigger machine, not a bigger
# number — the aligner is quadratic, so 16 minutes is not twice 8, it is four
# times. MIN_FREE_DISK_GB fails uploads closed before the disk fills, since
# uploads are kept and never reclaimed.
MAX_UPLOAD_GB=4
MAX_DURATION_MINUTES=8
MIN_FREE_DISK_GB=5
MAX_CONCURRENT_RENDERS=1

# --- The queue --------------------------------------------------------------
# Empty runs the queue inside the web process: one machine, no
# broker, and what every developer machine and CI use.
# Set it and the same messages travel through RabbitMQ instead,
# which is what lets the worker be a separate process and, after
# that, a separate host. The password belongs in .env, never here.
RABBITMQ_URL=amqp://vsw:CHANGE_ME@127.0.0.1:5672/vsw
