# Local configuration — .env.example is the committed template.
.env

# Scratch: uploads, rasterised band caches, finished renders.
var/
venv/
.venv/

__pycache__/
*.py[cod]

# The decoded design export is large and regenerable via
# tools/extract_mockup.py; keep the readable copy, drop the raw one.
design/mockup/page.html
design/mockup/assets/

.vscode/
.idea/
*.log

# Contact sheets from tools/preview_matrix.py. Rendered output, not source:
# they are rebuilt in a minute and would otherwise put megabytes of PNG in
# every commit that touched a layout.
preview/

# A one-off: copies the broker password and bucket keys from the web box
# into this machine.env so it can lend itself to the queue. Never committed.
lend-setup.py
.env.before-lending
*.bak-*
tools/.fontcache/
