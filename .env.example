# VideoSync_webapp — configuration template.
#
# Copy to `.env` and adjust. `.env` is git-ignored; this file is committed
# and also supplies the fallback defaults, so anything you don't override
# here still has a value.
#
# This app CREATES VIDEOS. It does not prepare scores and does not run
# synchronisation — music_line_extractor does both and writes an export
# package. The two repositories share no code, only the folder layout
# below, so these paths are the entire interface between them.
#
# A package is one folder containing:
#     lines/<first_measure>.{svg,png,jpg}   score band images
#     measures.data                         "<measure>\t<seconds>" per line
#     export.json                           manifest (geometry, style, entries)
#     chroma.npy                            present, unused here

# --- Where score packages live -------------------------------------------
# Several roots may be listed, separated by the OS path separator
# (";" on Windows, ":" on Linux).
#
# DIGITAL: exported from a digital score (.krn via Verovio). Ships .svg
#   bands, so they rasterise at any resolution, recolour cleanly, and can
#   be laid out for any aspect ratio. Export these with --fmt-svg.
# RASTER: exported from a scanned/OMR source. Ships .png/.jpg at a fixed
#   pixel size — usable, but cannot be scaled up or recoloured as well.
#
# Each package also declares its own kind via export.json -> options.is_digital;
# these settings only say where to look.
# Both the piece folder and a nested export/ subfolder are searched, so a
# root may be either a corpus of packages or a music_line_extractor
# project folder.
SCORE_ROOT_DIGITAL=C:\ZZ_perso\weefeen\PT\RD\music_line_extractor\project
SCORE_ROOT_RASTER=C:\VideoScoreSync\scores

# --- Which composer the library covers ------------------------------------
# Restricts the score list to one composer. Matched against each score's own
# Humdrum COM record (from score/source.krn), so it follows what the score
# declares rather than how its folder happens to be named. A score whose
# source names no composer is always admitted. Leave empty for no restriction.
COMPOSER_FILTER=Chopin

# --- Where source videos live --------------------------------------------
# Optional. Lets the app offer videos already on disk instead of requiring
# an upload every time.
VIDEO_ROOT=C:\ZZ_perso\weefeen\Chopin_Companion\Videos_downloaded_youtube

# --- Title panel fonts ----------------------------------------------------
# Only needed when rendering with a left title panel. Folder holding the
# Futura LT Pro .otf files. Defaults to ./assets/font/Futura in this repo;
# point it elsewhere rather than duplicating the font files.
FONT_DIR=C:\ZZ_perso\weefeen\PT\RD\VideoScoreSync\assets\font\Futura

# --- Backdrop art ---------------------------------------------------------
# Optional defaults for --background static / dynamic.
BACKGROUND_STATIC=C:\ZZ_perso\weefeen\PT\RD\VideoScoreSync\assets\images\template.png
BACKGROUND_DYNAMIC=C:\ZZ_perso\weefeen\Cliburn\video_template\02_Mortise-4-ScoreSound_HD_v04.mp4

# --- Tools ----------------------------------------------------------------
# Resolved on PATH when left as bare names.
FFMPEG_EXE=ffmpeg
FFPROBE_EXE=ffprobe

# --- Job workspace --------------------------------------------------------
# Everything this app writes: uploads, per-job sync workspaces, rasterised
# band caches and finished renders.
#
# Nothing is ever written into a score package. A package's performance/
# folder holds its reference recording (audio.wav + measures.data) and is
# what auto_sync_v4_reference aligns against — overwriting it destroys the
# reference. Job outputs therefore live here instead, which also keeps
# concurrent renders of the same score from clobbering each other.
WORK_DIR=C:\VideoScoreSync\jobs

# --- Recognition -----------------------------------------------------------
# music_finrgerprint names the piece from the performance audio. It is run as
# a subprocess with its own interpreter because identifying needs torch and
# CUDA, which this app must not carry. The repo is only ever read.
ID_ROOT=C:\ZZ_perso\weefeen\PT\RD\music_finrgerprint
ID_PYTHON=C:\Users\msmabq\.conda\envs\2026liszt\python.exe

# Holds amt_pitch_index.pkl and amt_chord_index.pkl. These are build products,
# not source: point this wherever the current index lives.
ID_INDEX_DIR=C:\ZZ_perso\weefeen\PT\RD\music_finrgerprint\data

# Maps a recognised recording to the score editions it backs.
PAIR_LIST=C:\ZZ_perso\weefeen\Chopin_Companion\Videos_downloaded_youtube\pair_list.json

# Below this many seconds the recogniser plans a single window, and a single
# window always agrees with itself — consensus reads 1.0 and the open-set gate
# stops meaning anything. Refuse rather than guess.
IDENTIFY_MIN_SECONDS=20
IDENTIFY_TIMEOUT=600

# The compute node's economics. Nothing creates a machine yet: these drive
# the SHADOW decision on the dashboard, so the grace period can be chosen
# from what real traffic does rather than guessed and then paid for.
#
# Grace is the largest cost lever. Creating a machine costs ~2 minutes of a
# visitor's wait, so tearing one down the instant a job ends makes the next
# job pay that again. Watch "The queue, and the idle clock" before changing.
COMPUTE_GRACE_SECONDS=600
# What an hour of the chosen plan costs, for turning hours into money.
COMPUTE_HOURLY_COST=0.108

# Where finished videos are put, so the machine that rendered one can be
# destroyed without taking it with it. A PRIVATE bucket: nothing here ever
# sets an ACL, and a download is a 302 to a link signed per click that lives
# fifteen minutes. Leave unset and results stay on local disk - fine here,
# and the reason a compute host may not be destroyed.
OBJECT_ENDPOINT=
OBJECT_REGION=
OBJECT_BUCKET=
OBJECT_KEY=
OBJECT_SECRET=

# Turning a visitor's internet address into a country and a city, so the
# question "where should the servers be" has an answer. A MaxMind-format
# database ON THIS DISK — the lookup never leaves the machine, and no
# visitor's address is sent to a geolocation service. Get the file with
# deploy/fetch-geoip.sh. Leave it unset and the visitor list still works,
# with the country and city columns empty.
GEOIP_DB=

# --- Alignment -------------------------------------------------------------
# VideoScoreSync turns the performance into a chroma matrix and warps it
# against the score package's own reference. Its own interpreter, and not by
# preference: chroma extraction ABORTS under this app's environment with
#   LLVM ERROR: Symbol not found: __svml_cosf8_ha
# because numba there has no Intel vector math library. An abort cannot be
# caught, so it must be a separate process.
VSS_ROOT=C:\ZZ_perso\weefeen\PT\RD\VideoScoreSync
SYNC_PYTHON=C:\Users\msmabq\.conda\envs\2026liszt\python.exe
SYNC_TIMEOUT=900

# --- Telling people their video is ready -----------------------------------
# Names only here; put the real values in .env, which is not committed.
# Leave SMTP_HOST empty and the app sends nothing and says so, rather than
# promising an email that never arrives.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Weefeen <no-reply@weefeen.com>

# Where a monitoring alert goes. NOT a visitor-facing address and never used
# for anything a visitor causes - this is the operator's own mailbox, and the
# only thing that reaches it is Grafana saying the machine is running out of
# memory. deploy/install-alert-mail.sh reads it from here.
ALERT_EMAIL=
# 465 wants SMTP_SSL=true; 587 wants SMTP_STARTTLS=true.
SMTP_SSL=false
SMTP_STARTTLS=true
# Where a link in that mail should point. Without it, nothing is sent — and
# mail is refused while it points at this machine, as it does below: a link
# to 127.0.0.1 means nothing to whoever receives it, and Gmail reads an
# unreachable private address as near-conclusive spam, which spends the
# domain's standing on a message nobody could have used. So a local install
# renders and shows the link, and simply does not post it.
PUBLIC_BASE_URL=http://127.0.0.1:5057

# --- How much one visitor may use ------------------------------------------
# There is no sign-in, so a visitor is recognised by the address they came
# from — a weak identity, which is why the video allowance is counted over a
# week rather than a day: a coarse window is harder to wait out.
# Every value here is a maximum per window. Raise them for a busy install.

# Bursts. Cheap to ask for, so these only stop a loop.
LIMIT_UPLOADS_PER_HOUR=8
# Recognition holds the GPU for about forty-five seconds a time.
LIMIT_IDENTIFY_PER_HOUR=8

# Finished videos: minutes of work, and a file that has to be kept.
LIMIT_RENDERS_PER_WEEK=3
LIMIT_RENDERS_PER_EMAIL_WEEK=3

# Mail goes to an address somebody typed, so it is capped hardest — both
# per address and across the whole install.
LIMIT_MAIL_PER_EMAIL_WEEK=4

# The queued notice has its OWN allowance. A courtesy must never be able
# to spend the budget of the mail that carries the promise: with one
# shared cap, adding it refused the "your video is ready" mail for
# somebody who had waited an hour, silently.
LIMIT_QUEUED_MAIL_PER_EMAIL_WEEK=4
LIMIT_MAIL_PER_DAY=200

# Set only when a reverse proxy sits in front and sets X-Forwarded-For.
# Left off, the header is ignored: it is written by the client, and trusting
# it would let anyone spend everybody else's allowance.
TRUST_PROXY=false

# --- How long a finished video stays downloadable --------------------------
# The link in the email works for this long, then the video moves to cold
# storage. It is archived, not deleted, and the expired page says so.
#
# Enforced here rather than by the storage lifecycle rule: those run in whole
# days and asynchronously, so a rule aimed at the same moment would sometimes
# fire first and leave a working link pointing at an object that takes hours
# to retrieve. The transition is therefore set a day later than the expiry.
RETENTION_HOT_HOURS=48
ARCHIVE_TRANSITION_DAYS=3

# --- Size and length --------------------------------------------------------
# The values the code already defaults to, written down so that a local
# install and the server can be compared line by line rather than by reading
# app/routes.py.
#
# Length is what costs, not size: the render is a fixed 1080p canvas whatever
# arrives, the encode grows with duration, and the aligner's memory grows with
# its square. 25 minutes takes about 32 minutes to render on two shared cores.
MAX_UPLOAD_GB=4
MAX_DURATION_MINUTES=25

# One render at a time. Two on a two-core box makes both slower than running
# them in turn, and the queue exists so that nobody has to.
MAX_CONCURRENT_RENDERS=1

# --- The queue --------------------------------------------------------------
# Empty runs the queue inside the web process: one machine, no
# broker, and what every developer machine and CI use.
# Set it and the same messages travel through RabbitMQ instead,
# which is what lets the worker be a separate process and, after
# that, a separate host. The password belongs in .env, never here.
RABBITMQ_URL=
