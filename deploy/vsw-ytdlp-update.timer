[Unit]
Description=Daily yt-dlp update check
Documentation=https://github.com/weefeen/VideoSync_webapp

[Timer]
# Daily, in the small hours, and NOT on the hour: every timer on every box
# that says 03:00 fires at 03:00, and PyPI sees all of them at once.
OnCalendar=*-*-* 03:17:00
# A box that was off at 03:17 checks when it comes back rather than waiting
# until tomorrow. This is the whole reason to prefer a timer over cron here.
Persistent=true
# Up to twenty minutes of scatter on top, for the same reason as the odd
# minute above.
RandomizedDelaySec=1200
Unit=vsw-ytdlp-update.service

[Install]
WantedBy=timers.target
