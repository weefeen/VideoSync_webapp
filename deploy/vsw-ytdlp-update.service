[Unit]
# Keeps yt-dlp current, because a stale one is a silent outage.
#
# YouTube changes how a stream is addressed every few weeks; the installed
# yt-dlp then fails every download with a message about formats, and
# nothing else looks wrong. Pinning a version guarantees that outage on an
# unknown date, so the safe state is the newest release, checked daily.
Description=Update yt-dlp in the VideoSync virtualenv
Documentation=https://github.com/weefeen/VideoSync_webapp
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ROOT, not vsw: it writes into /srv/vsw/venv, which vsw does not own. It
# runs pip against one package and nothing else touches the machine.
User=root
WorkingDirectory=/srv/vsw/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /srv/vsw/current/deploy/yt-dlp-update.sh

# A failed update is not an emergency: the previous version stays installed
# and keeps working until YouTube next changes. It exits non-zero so the
# failure is visible in `systemctl list-units --failed`, and tomorrow's
# timer tries again.
TimeoutStartSec=600
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
